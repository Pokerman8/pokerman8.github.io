{% capture footer_contents %}
  &copy; Ji-Ping Jin | Last updated: May 2026 {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.newsletter.enabled %}
  {% include newsletter.liquid %}
{% endif %}

<div class="footer-divider"></div>

<div class="footer-quote">
  &ldquo;There is only one success &mdash; to be able to spend your life in your own way.&rdquo;
  <span class="quote-author">&mdash; Christopher Morley</span>
</div>

<div class="site-footer">
  {{ footer_contents }}
</div>
