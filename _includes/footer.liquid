{% capture footer_contents %}
  &copy; Ji-Ping Jin. Last updated {{ site.time | date: '%B %Y' }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
{% endcapture %}

{% if site.newsletter.enabled %}
  {% include newsletter.liquid %}
{% endif %}

<footer class="site-foot{% if page.layout == 'about' %} home-section{% endif %}">
  <div class="section-body">
    <blockquote class="footer-quote">
      <p>&ldquo;There is only one success &mdash; to be able to spend your life in your own way.&rdquo;</p>
      <cite>Christopher Morley</cite>
    </blockquote>
    <p class="site-footer">{{ footer_contents | strip }}</p>
  </div>
</footer>
