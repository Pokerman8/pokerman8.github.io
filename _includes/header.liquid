<header class="minimal-header">
  <div class="container">
    <a class="site-name" href="{{ site.baseurl }}/">
      {%- if site.first_name -%}
        {{- site.first_name -}}
      {%- endif -%}
      {%- if site.middle_name -%}
        &nbsp;{{- site.middle_name -}}
      {%- endif -%}
      {%- if site.last_name -%}
        &nbsp;{{- site.last_name -}}
      {%- endif -%}
    </a>
  </div>
</header>
