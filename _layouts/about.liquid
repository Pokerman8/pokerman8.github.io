---
layout: default
---
<div class="post">
  <article>
    <!-- Profile header: name left, photo right -->
    <header class="profile-header">
      <div class="profile-identity">
        <h1 class="name-heading">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        {% if page.subtitle %}
          <p class="subtitle">{{ page.subtitle }}</p>
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
        <div class="contact-icons-header">
          <div class="contact-icons-row">
            <a href="mailto:pokerman13jjp@gmail.com" title="Gmail">
              <i class="fa-solid fa-envelope"></i>
            </a>
            <a href="https://scholar.google.com/citations?user=bwKzizwAAAAJ" title="Google Scholar">
              <i class="ai ai-google-scholar"></i>
            </a>
            <a href="https://github.com/Pokerman8" title="GitHub">
              <img src="{{ '/assets/img/GitHub.svg' | relative_url }}" alt="GitHub">
            </a>
            <a href="{{ '/assets/pdf/cv.pdf' | relative_url }}" title="CV">
              <img src="{{ '/assets/img/cv.svg' | relative_url }}" alt="CV">
            </a>
          </div>
          <div class="contact-icons-row">
            <a href="https://x.com/jhon0v0" title="X / Twitter">
              <i class="fa-brands fa-x-twitter"></i>
            </a>
            <a href="https://www.instagram.com/johnny_ovo_/" title="Instagram">
              <i class="fa-brands fa-instagram"></i>
            </a>
          </div>
        </div>
      </div>
      {% if page.profile.image %}
        <div class="profile-photo">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% capture sizes %}(min-width: {{ site.max_width }}) 140px, 30vw{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path
            class="img-fluid" sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        </div>
      {% endif %}
    </header>

    <!-- Bio -->
    <section id="bio" class="bio-section">
      <div class="clearfix">{{ content }}</div>
    </section>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section id="news" class="news-section">
        <h2>
          <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <section id="blog" class="blog-section">
        <h2>
          <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
        </h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section id="publications" class="publications-section">
        <h2>
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
        </h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Rejected papers -->
    {% if page.rejected_papers and page.rejected_papers.enabled %}
      <section id="rejected" class="rejected-section">
        <h2>Rejected Papers</h2>
        {% include rejected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <section id="contact" class="social-section">
        <div class="social">
          <div class="contact-icons">{% include social.liquid %}</div>
          <div class="contact-note">{{ site.contact_note }}</div>
        </div>
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}

    <div style="margin-top: 2rem; text-align: center;">
      <div style="display: inline-block; max-width: 240px; width: 100%; overflow: hidden;">
        <script
          type="text/javascript"
          id="mapmyvisitors"
          src="https://mapmyvisitors.com/map.js?d=-PHdF483eG3rGLBrQCwf1UN0_xytkAn6hie0s5toUXE&cl=ffffff&w=a"
        ></script>
      </div>
    </div>
  </article>
</div>
